  "shortcuts": [
    { "name": "Family chat", "short_name": "Chat", "url": "./#/chat", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Arcade", "short_name": "Games", "url": "./#/games", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Kudos shop", "short_name": "Shop", "url": "./#/shop", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
